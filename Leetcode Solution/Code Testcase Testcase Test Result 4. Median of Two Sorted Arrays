class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        """
        :type nums1: List[int]
        :type nums2: List[int]
        :rtype: float
        """
        arr = nums1 + nums2
        arr.sort()
        leng = len(arr)
        if leng % 2 == 0:
            mid = leng // 2
            ele = (arr[mid] + arr[mid-1]) / 2.0
            return ele
        else :
            mid = leng // 2
            return arr[mid]

        
